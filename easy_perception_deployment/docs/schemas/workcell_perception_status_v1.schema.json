{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workcell-studio.local/schemas/workcell_perception_status_v1.schema.json",
  "title": "Workcell Studio perception status v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_schema_version",
    "mode",
    "state",
    "scene_id",
    "camera_id",
    "source_mode",
    "object_count",
    "epd_connected",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "workcell_perception_status/v1"
    },
    "contract_schema_version": {
      "const": "workcell_perception_snapshot/v1"
    },
    "mode": {
      "enum": ["live", "replay"]
    },
    "state": {
      "enum": ["WAITING", "READY", "STALE", "FAILED", "DISABLED"]
    },
    "scene_id": {
      "type": "string"
    },
    "camera_id": {
      "type": "string"
    },
    "profile_ref": {
      "type": "string"
    },
    "source_mode": {
      "enum": ["tracking", "localization", "auto"]
    },
    "source_message_type": {
      "type": "string"
    },
    "last_timestamp": {
      "type": ["string", "number", "null"]
    },
    "last_timestamp_ns": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "object_count": {
      "type": "integer",
      "minimum": 0
    },
    "stable_tracking_ids": {
      "type": "boolean"
    },
    "last_msg_age_s": {
      "type": ["number", "null"],
      "minimum": 0.0
    },
    "epd_connected": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "backend": {
      "type": "object",
      "properties": {
        "available": {"type": "boolean"},
        "level": {"type": ["integer", "null"]},
        "message": {"type": "string"},
        "hardware_id": {"type": "string"},
        "values": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
