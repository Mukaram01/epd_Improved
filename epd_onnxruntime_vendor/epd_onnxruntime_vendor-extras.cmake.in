# NOTE: onnxruntime installs the ONNX headers it depends on, but it does not
# ship an ONNXConfig.cmake. Downstream packages should consume the vendored
# onnxruntime library and headers from this package, so we intentionally skip
# find_package(ONNX) here.
set(onnxruntime_opt "${@PROJECT_NAME@_DIR}/../../../opt/epd_onnxruntime_vendor")

find_library(
  onnxruntime_LIBRARIES
  NAMES onnxruntime
  PATHS ${onnxruntime_opt}/lib
  NO_DEFAULT_PATH
)
find_path(
  onnxruntime_INCLUDE_DIR
  NAMES onnxruntime_cxx_api.h
  PATHS
    ${onnxruntime_opt}/include
    ${onnxruntime_opt}/include/onnxruntime/core/session
  NO_DEFAULT_PATH
)

if(NOT onnxruntime_LIBRARIES)
  message(FATAL_ERROR
    "epd_onnxruntime_vendor: could not find libonnxruntime under "
    "${onnxruntime_opt}/lib. "
    "Make sure the package was built and installed before using it.")
endif()

message(STATUS "epd_onnxruntime_vendor: found onnxruntime library at ${onnxruntime_LIBRARIES}")

set(epd_onnxruntime_vendor_LIBRARY_DIRS ${onnxruntime_opt}/lib)
set(epd_onnxruntime_vendor_LIBRARIES ${onnxruntime_LIBRARIES})
set(epd_onnxruntime_vendor_INCLUDE_DIRS
  ${onnxruntime_opt}/include
  ${onnxruntime_INCLUDE_DIR}
)

# Provide a modern IMPORTED target so downstream packages can also use
#   target_link_libraries(<target> epd_onnxruntime_vendor::onnxruntime)
# find_library() always returns a single file path, so IMPORTED_LOCATION
# is always a scalar value here.
if(NOT TARGET epd_onnxruntime_vendor::onnxruntime)
  add_library(epd_onnxruntime_vendor::onnxruntime SHARED IMPORTED)
  set_target_properties(epd_onnxruntime_vendor::onnxruntime PROPERTIES
    IMPORTED_LOCATION "${onnxruntime_LIBRARIES}"
    INTERFACE_INCLUDE_DIRECTORIES "${epd_onnxruntime_vendor_INCLUDE_DIRS}"
  )
endif()
